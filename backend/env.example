PORT=5000

# Gates cookie Secure/SameSite flags and stack-trace suppression, not just logs.
# The Docker image pins this to production.
NODE_ENV=development

# For bare-metal `npm run dev`. docker-compose overrides this with the service name.
MONGODB_URI=mongodb://localhost:27017/roasthub

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required at boot — config/env.ts exits non-zero if these (or the JWT secrets)
# are missing. GOOGLE_CLIENT_ID verifies Google ID tokens
# (format: <numeric>.apps.googleusercontent.com).
GOOGLE_CLIENT_ID=
GOOGLE_AI_KEY=

# Max upload size (default 10MB)
UPLOAD_MAX_BYTES=10485760

# Browser origin(s) allowed for CORS. Comma-separated for prod + Vercel preview URLs.
# Example Vercel split deploy: https://your-frontend.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# When frontend and API are different sites (e.g. two Vercel projects), set true so refresh cookies send on API fetch.
CROSS_SITE_COOKIES=false

# Trust proxy hops (default 1 for Vercel). Override if you have a deeper proxy chain.
TRUST_PROXY=1

# Hard ceiling on free (no-account) AI roasts per UTC day, across ALL visitors.
# Per-IP limits can't stop a distributed script; this bounds the worst-case
# Gemini bill. Requires Upstash to be shared across serverless instances.
TRY_ROAST_DAILY_BUDGET=200
