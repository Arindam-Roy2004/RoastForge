{
  "version": 2,
  "installCommand": "npm install --include=dev",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/pdf-parse/**,src/modules/analysis/roast-system-prompt.txt",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}